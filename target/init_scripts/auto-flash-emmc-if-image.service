[Unit]
Description=Auto flash internal mmc if image exists
ConditionPathExists=/emmc-flash-4gb.img
ConditionPathExists=/dev/mmcblk1
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c "dd if=/dev/mmcblk1 of=/emmc-saved.img bs=1M && dd if=/emmc-flash-4gb.img of=/dev/mmcblk1 bs=1M && mv /emmc-flash-4gb.img /emmc-flashed.img"

[Install]
WantedBy=multi-user.target
